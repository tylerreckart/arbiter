# Copy to /etc/arbiter/arbiter.env and chmod 600.
# Loaded by systemd via EnvironmentFile= — do not commit real secrets.

# Required for hosted models (OpenRouter). Prefer env over files under HOME.
OPENROUTER_API_KEY=sk-or-replace-me

# Optional: pin the admin token instead of reading ~/.arbiter/admin_token.
# Generate with: openssl rand -hex 32  →  prefix with adm_
# ARBITER_ADMIN_TOKEN=adm_replace_me

# Public HTTPS origin (no trailing slash). Used in A2A agent cards when
# TLS terminates at the reverse proxy.
ARBITER_PUBLIC_BASE_URL=https://arbiter.example.com

# Optional: structured logs for journald / aggregators.
# ARBITER_LOG_FORMAT=json

# Optional: drain in-flight SSE on SIGTERM (seconds).
# ARBITER_DRAIN_SECONDS=60

# Optional: per-tenant guardrails for a public API (defaults are unlimited).
# ARBITER_TENANT_MAX_CONCURRENT=4
# ARBITER_TENANT_RATE_PER_MIN=30
# ARBITER_TENANT_RATE_BURST=10

# Optional: web search for agent /search
# ARBITER_SEARCH_PROVIDER=brave
# ARBITER_SEARCH_API_KEY=

# Optional: Docker sandbox for /exec (leave unset to keep /exec disabled).
# ARBITER_SANDBOX_IMAGE=arbiter/sandbox:latest
# ARBITER_SANDBOX_NETWORK=none
